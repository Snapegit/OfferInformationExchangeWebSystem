<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.ZhaopinpiciDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.ZhaopinpiciEntity" id="zhaopinpiciMap">
        <result property="zhaopinpici" column="zhaopinpici"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.ZhaopinpiciView" >

		SELECT  zhaopinpici.* FROM zhaopinpici  zhaopinpici 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.ZhaopinpiciView" >
		SELECT * FROM zhaopinpici  zhaopinpici <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
